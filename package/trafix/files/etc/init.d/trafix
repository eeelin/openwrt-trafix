#!/bin/sh /etc/rc.common

START=70
STOP=60

EXTRA_COMMANDS="update check dryrun_start dryrun_stop dryrun_restart"
EXTRA_HELP="        update          Rebuild and apply runtime state\n\
        check           Print current network status\n\
\t    dryrun_start    Print commands that would be executed during start\n\
\t    dryrun_stop     Print commands that would be executed during stop\n\
\t    dryrun_restart  Print commands that would be executed during restart"

STATE_DIR=/var/trafix
RUNTIME_ENV="$STATE_DIR/runtime.env"
DRY_RUN="${TRAFIX_DRY_RUN:-0}"
DEFAULT_CONFIG_FILE=/etc/trafix/config.yaml
TRAFIX_UPDATE_LIB=/usr/lib/trafix/update.sh
OWNER_BYPASS_USER=
OWNER_BYPASS_UID=
PROXY_IPSET_CONF="$STATE_DIR/proxy-ipset.conf"
PROXY_IPSET_NET_CONF="$STATE_DIR/proxy-ipset-net.conf"
PROXY_IP6SET_CONF="$STATE_DIR/proxy-ip6set.conf"
PROXY_IP6SET_NET_CONF="$STATE_DIR/proxy-ip6set-net.conf"

BYPASS_IPSET_CONF="$STATE_DIR/bypass-ipset.conf"
BYPASS_IPSET_NET_CONF="$STATE_DIR/bypass-ipset-net.conf"
BYPASS_IP6SET_CONF="$STATE_DIR/bypass-ip6set.conf"
BYPASS_IP6SET_NET_CONF="$STATE_DIR/bypass-ip6set-net.conf"

BLOCK_IPSET_CONF="$STATE_DIR/block-ipset.conf"
BLOCK_IPSET_NET_CONF="$STATE_DIR/block-ipset-net.conf"
BLOCK_IP6SET_CONF="$STATE_DIR/block-ip6set.conf"
BLOCK_IP6SET_NET_CONF="$STATE_DIR/block-ip6set-net.conf"

check_ip() {
	prompt="$1"
	cip="$2"
	[ -n "$cip" ] || return 0
	info="$(curl -s "https://ipinfo.io/${cip}" | jq -r '.city + " / " + .country' 2>/dev/null)"
	echo "${prompt} --> ${cip} [${info}]"
}

resolve_config_file() {
	config_file="${TRAFIX_CONFIG:-}"
	if [ -z "$config_file" ] && command -v uci >/dev/null 2>&1; then
		config_file="$(uci -q get trafix.general.config_file 2>/dev/null)"
	fi
	if [ -z "$config_file" ]; then
		config_file="$DEFAULT_CONFIG_FILE"
	fi
	echo "$config_file"
}

run_cmd() {
	if [ "$DRY_RUN" = 1 ]; then
		echo "+ $*"
	else
		eval "$@"
	fi
}

service_log() {
	echo "[trafix/init] $*"
}

validate_nft_runtime() {
	command -v nft >/dev/null 2>&1 || {
		echo "[trafix/init] ERROR: nft is required" >&2
		return 1
	}
	command -v dnsmasq >/dev/null 2>&1 || {
		echo "[trafix/init] ERROR: dnsmasq is required" >&2
		return 1
	}
	dnsmasq --version | grep -m1 'Compile time options:' | grep -q ' nftset\( \|$\)' || {
		echo "[trafix/init] ERROR: dnsmasq does not support nftset" >&2
		return 1
	}
}

update_runtime_state() {
	config_file="$(resolve_config_file)"
	service_log "building runtime state from $config_file"
	if [ ! -r "$TRAFIX_UPDATE_LIB" ]; then
		echo "[trafix/init] ERROR: update library not found: $TRAFIX_UPDATE_LIB" >&2
		return 1
	fi
	if ! (
		export TRAFIX_CONFIG="$config_file"
		. "$TRAFIX_UPDATE_LIB"
		trafix_build_runtime_state
	); then
		echo "[trafix/init] ERROR: failed to build runtime state" >&2
		return 1
	fi
	[ -f "$RUNTIME_ENV" ] || {
		echo "[trafix/init] ERROR: update completed without creating $RUNTIME_ENV" >&2
		return 1
	}
}

resolve_owner_bypass() {
	config_get OWNER_BYPASS_USER 'general' 'owner_bypass_user'
	[ -n "$OWNER_BYPASS_USER" ] || return 0
	command -v id >/dev/null 2>&1 || {
		echo "[trafix/init] ERROR: id is required for owner_bypass_user" >&2
		return 1
	}
	OWNER_BYPASS_UID="$(id -u "$OWNER_BYPASS_USER" 2>/dev/null)" || {
		echo "[trafix/init] ERROR: owner bypass user does not exist: $OWNER_BYPASS_USER" >&2
		return 1
	}
	[ "$OWNER_BYPASS_UID" != 0 ] || {
		echo "[trafix/init] ERROR: refusing owner bypass for uid 0" >&2
		return 1
	}
	service_log "owner bypass: $OWNER_BYPASS_USER (uid $OWNER_BYPASS_UID)"
}

test_dns_domain() {
	family="$1"
	domain="$2"
	label_family="$(printf "%s" "$family" | tr "[:lower:]" "[:upper:]")"
	case "$family" in
		ipv4)
			record_type="a"
			;;
		ipv6)
			record_type="aaaa"
			;;
		*)
			return 1
			;;
	esac
	gip="$(dig "$domain" "$record_type" | awk -v domain="$domain" '$1 == domain"." {print $5; exit}')"
	[ -n "$gip" ] && info="$(curl -s "https://ipinfo.io/${gip}" | jq -r '.org + " @ " + .city + " / " + .country' 2>/dev/null)" && echo "[DNS/${label_family}] ${domain} --> ${gip} [${info}]"
}

test_dns() {
	config_file="$(resolve_config_file)"
	command -v yq >/dev/null 2>&1 || {
		echo "[DNS] yq not available, skip dns tests"
		return 0
	}
	for family in ipv4 ipv6; do
		yq -r "(.status_tests.dns.${family} // [])[]" "$config_file" 2>/dev/null | while IFS= read -r domain; do
			[ -n "$domain" ] && test_dns_domain "$family" "$domain"
		done
	done
}

ensure_proxy() {
	name="$1"
	family="$2"
	case "$family" in
		ipv4)
			record_type="a"
			set_name="proxy4"
			;;
		ipv6)
			record_type="aaaa"
			set_name="proxy6"
			;;
		*)
			return 1
			;;
	esac
	ips="$(nslookup -type="$record_type" "$name" | awk '/Address / && $3 != "127.0.0.1" {print $3}')"
	for ip in $ips; do
		nft get element inet trafix "$set_name" "{ $ip }" >/dev/null 2>&1 || {
			echo "nft add element inet trafix ${set_name} { ${ip} } for ${name}"
			run_cmd "nft add element inet trafix \"$set_name\" \"{ $ip }\""
		}
	done
}

status_http_test() {
	action="$1"
	family="$2"
	domain="$3"
	url="$4"
	case "$family" in
		ipv4)
			curl_flag="-4"
			;;
		ipv6)
			curl_flag="-6"
			;;
		*)
			return 1
			;;
	esac
	[ "$action" = "proxy" ] && ensure_proxy "$domain" "$family"
	label_action=$(printf "%s" "$action" | tr "[:lower:]" "[:upper:]")
	label_family=$(printf "%s" "$family" | tr "[:lower:]" "[:upper:]")
	check_ip "[${label_action}/${label_family}] ${domain}" "$(curl -s ${curl_flag} "$url" 2>/dev/null)"
}

status_group() {
	action="$1"
	family="$2"
	config_file="$3"
	command -v yq >/dev/null 2>&1 || {
		echo "[status/${action}/${family}] yq not available, skip"
		return 0
	}
	yq -o=json ".status_tests.${action}.${family} // []" "$config_file" 2>/dev/null | \
		jq -r '.[]? | [.domain // "", .url // ""] | @tsv' | \
		while IFS="$(printf '\t')" read -r domain url; do
			[ -n "$domain" ] && [ -n "$url" ] && status_http_test "$action" "$family" "$domain" "$url"
		done
}

check() {
	config_file="$(resolve_config_file)"
	status_group proxy ipv4 "$config_file"
	status_group proxy ipv6 "$config_file"
	status_group bypass ipv4 "$config_file"
	status_group bypass ipv6 "$config_file"
	test_dns
}

load_runtime_env() {
	if [ -f "$RUNTIME_ENV" ]; then
		. "$RUNTIME_ENV"
	else
		FINAL_ACTION=bypass
	fi
}

add_nft_entries() {
	set_name="$1"
	file_path="$2"
	[ -f "$file_path" ] || return 0
	while IFS= read -r value; do
		[ -n "$value" ] && run_cmd "nft add element inet trafix \"$set_name\" \"{ $value }\" 2>/dev/null || true"
	done < "$file_path"
}

create_nft_set() {
	set_name="$1"
	address_type="$2"
	run_cmd "nft 'add set inet trafix $set_name { type $address_type; flags interval; }' 2>/dev/null || true"
}

setup_nft_sets() {
	run_cmd "nft add table inet trafix 2>/dev/null || true"
	for set_name in proxy4 proxy4_net bypass4 bypass4_net block4 block4_net; do
		create_nft_set "$set_name" ipv4_addr
	done
	for set_name in proxy6 proxy6_net bypass6 bypass6_net block6 block6_net; do
		create_nft_set "$set_name" ipv6_addr
	done

	add_nft_entries proxy4 "$PROXY_IPSET_CONF"
	add_nft_entries proxy4_net "$PROXY_IPSET_NET_CONF"
	add_nft_entries proxy6 "$PROXY_IP6SET_CONF"
	add_nft_entries proxy6_net "$PROXY_IP6SET_NET_CONF"
	add_nft_entries bypass4 "$BYPASS_IPSET_CONF"
	add_nft_entries bypass4_net "$BYPASS_IPSET_NET_CONF"
	add_nft_entries bypass6 "$BYPASS_IP6SET_CONF"
	add_nft_entries bypass6_net "$BYPASS_IP6SET_NET_CONF"
	add_nft_entries block4 "$BLOCK_IPSET_CONF"
	add_nft_entries block4_net "$BLOCK_IPSET_NET_CONF"
	add_nft_entries block6 "$BLOCK_IP6SET_CONF"
	add_nft_entries block6_net "$BLOCK_IP6SET_NET_CONF"
}

flush_nft_sets() {
	for set_name in proxy4 proxy4_net bypass4 bypass4_net block4 block4_net \
		proxy6 proxy6_net bypass6 bypass6_net block6 block6_net; do
		run_cmd "nft flush set inet trafix $set_name 2>/dev/null || true"
	done
}

delete_nft_chains() {
	for chain_name in prerouting output_nat forward_filter output_filter; do
		run_cmd "nft delete chain inet trafix $chain_name 2>/dev/null || true"
	done
}

cleanup_legacy_iptables() {
	# Remove hooks/chains left behind when upgrading from the ipset backend.
	for family_cmd in iptables ip6tables; do
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -D OUTPUT -j TRAFIX_FILTER_OUTPUT 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -D OUTPUT -j TRAFIX_FILTER 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -D FORWARD -j TRAFIX_FILTER 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -F TRAFIX_FILTER_OUTPUT 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -X TRAFIX_FILTER_OUTPUT 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -F TRAFIX_FILTER 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -X TRAFIX_FILTER 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -t nat -D OUTPUT -j TRAFIX_OUTPUT 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -t nat -D OUTPUT -j TRAFIX 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -t nat -D PREROUTING -j TRAFIX 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -t nat -F TRAFIX_OUTPUT 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -t nat -X TRAFIX_OUTPUT 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -t nat -F TRAFIX 2>/dev/null || true"
		run_cmd "command -v $family_cmd >/dev/null 2>&1 || true; $family_cmd -t nat -X TRAFIX 2>/dev/null || true"
	done
	for set_name in trafix trafix-net trafix6 trafix6-net \
		trafix-bypass trafix-bypass-net trafix6-bypass trafix6-bypass-net \
		trafix-block trafix-block-net trafix6-block trafix6-block-net; do
		run_cmd "command -v ipset >/dev/null 2>&1 || true; ipset destroy $set_name 2>/dev/null || true"
	done
}

add_nft_rule() {
	chain_name="$1"
	shift
	run_cmd "nft add rule inet trafix $chain_name $*"
}

setup_nftables() {
	port4="$1"
	port6="$2"
	load_runtime_env
	setup_nft_sets
	delete_nft_chains

	run_cmd "nft 'add chain inet trafix prerouting { type nat hook prerouting priority dstnat; policy accept; }'"
	run_cmd "nft 'add chain inet trafix output_nat { type nat hook output priority dstnat; policy accept; }'"
	run_cmd "nft 'add chain inet trafix forward_filter { type filter hook forward priority filter; policy accept; }'"
	run_cmd "nft 'add chain inet trafix output_filter { type filter hook output priority filter; policy accept; }'"

	if [ -n "$OWNER_BYPASS_UID" ]; then
		add_nft_rule output_nat meta skuid "$OWNER_BYPASS_UID" return
		add_nft_rule output_filter meta skuid "$OWNER_BYPASS_UID" return
	fi

	for chain_name in prerouting output_nat; do
		add_nft_rule "$chain_name" ip daddr @bypass4 return
		add_nft_rule "$chain_name" ip daddr @bypass4_net return
		add_nft_rule "$chain_name" ip6 daddr @bypass6 return
		add_nft_rule "$chain_name" ip6 daddr @bypass6_net return
		case "$FINAL_ACTION" in
			proxy)
				add_nft_rule "$chain_name" meta nfproto ipv4 meta l4proto tcp redirect to ":$port4"
				add_nft_rule "$chain_name" meta nfproto ipv6 meta l4proto tcp redirect to ":$port6"
				;;
			*)
				add_nft_rule "$chain_name" ip daddr @proxy4 meta l4proto tcp redirect to ":$port4"
				add_nft_rule "$chain_name" ip daddr @proxy4_net meta l4proto tcp redirect to ":$port4"
				add_nft_rule "$chain_name" ip6 daddr @proxy6 meta l4proto tcp redirect to ":$port6"
				add_nft_rule "$chain_name" ip6 daddr @proxy6_net meta l4proto tcp redirect to ":$port6"
				;;
		esac
	done

	for chain_name in forward_filter output_filter; do
		add_nft_rule "$chain_name" ip daddr @block4 drop
		add_nft_rule "$chain_name" ip daddr @block4_net drop
		add_nft_rule "$chain_name" ip6 daddr @block6 drop
		add_nft_rule "$chain_name" ip6 daddr @block6_net drop
		config_get_bool block_proxy_http3 'general' 'block_proxy_http3'
		[ "$block_proxy_http3" = 1 ] || continue
		case "$FINAL_ACTION" in
			proxy)
				add_nft_rule "$chain_name" ip daddr @bypass4 return
				add_nft_rule "$chain_name" ip daddr @bypass4_net return
				add_nft_rule "$chain_name" ip6 daddr @bypass6 return
				add_nft_rule "$chain_name" ip6 daddr @bypass6_net return
				add_nft_rule "$chain_name" udp dport 443 drop
				;;
			*)
				add_nft_rule "$chain_name" ip daddr @proxy4 udp dport 443 drop
				add_nft_rule "$chain_name" ip daddr @proxy4_net udp dport 443 drop
				add_nft_rule "$chain_name" ip6 daddr @proxy6 udp dport 443 drop
				add_nft_rule "$chain_name" ip6 daddr @proxy6_net udp dport 443 drop
				;;
		esac
	done
}

start() {
	service_log "starting"
	initialized_now=0
	[ "$DRY_RUN" = 1 ] || validate_nft_runtime || return 1
	if [ "$DRY_RUN" != 1 ] && [ ! -f "$RUNTIME_ENV" ]; then
		service_log "runtime state is not initialized; running initial update"
		update_runtime_state || return 1
		initialized_now=1
	elif [ "$DRY_RUN" != 1 ]; then
		service_log "using initialized runtime state (run '/etc/init.d/trafix update' to rebuild)"
	else
		service_log "dry-run: using existing runtime state"
	fi

	config_load 'trafix'
	config_get port4 'general' 'redir_ipv4_port'
	config_get port6 'general' 'redir_ipv6_port'
	resolve_owner_bypass || return 1

	cleanup_legacy_iptables
	service_log "configuring nftables sets, filters, and redirects (IPv4 port: $port4, IPv6 port: $port6)"
	setup_nftables "$port4" "$port6"
	if [ "$initialized_now" = 1 ]; then
		service_log "restarting dnsmasq to load generated nftset configuration"
		restart_dnsmasq || {
			echo "[trafix/init] ERROR: failed to restart dnsmasq" >&2
			return 1
		}
	fi
	load_runtime_env
	service_log "started (final action: $FINAL_ACTION)"
}

restart_dnsmasq() {
	/etc/init.d/dnsmasq restart
}

update() {
	service_log "updating runtime state"
	update_runtime_state || return 1
	service_log "reapplying nftables rules and sets"
	stop
	flush_nft_sets
	start || return 1
	service_log "restarting dnsmasq to load generated nftset configuration"
	restart_dnsmasq || {
		echo "[trafix/init] ERROR: failed to restart dnsmasq" >&2
		return 1
	}
	service_log "update applied"
}

stop() {
	service_log "stopping and removing nftables rules"
	delete_nft_chains
	service_log "stopped"
}

dryrun_start() {
	DRY_RUN=1
	load_runtime_env
	echo "# dry-run start (FINAL_ACTION=${FINAL_ACTION})"
	start
}

dryrun_stop() {
	DRY_RUN=1
	echo "# dry-run stop"
	stop
}

dryrun_restart() {
	DRY_RUN=1
	load_runtime_env
	echo "# dry-run restart (FINAL_ACTION=${FINAL_ACTION})"
	stop
	start
}
